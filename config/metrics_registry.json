{
  "schema_version": 1,
  "required_metrics": [
    "run_status",
    "replica_index",
    "random_seed",
    "objective_best",
    "evaluations",
    "runtime_total_seconds",
    "feasible",
    "constraint_violation"
  ],
  "profiles": {
    "minimal": [],
    "convergence": [
      "iteration_index",
      "iteration_time_seconds"
    ],
    "optimizer": [
      "iteration_index",
      "iteration_time_seconds",
      "objective_mean",
      "objective_std",
      "diversity_hussain",
      "exploration_percent",
      "exploitation_percent",
      "population_entropy",
      "diversity_dimension_mean",
      "diversity_dimension_min",
      "diversity_dimension_max"
    ],
    "fuzzy": [
      "iteration_index",
      "iteration_time_seconds",
      "objective_mean",
      "objective_std",
      "diversity_hussain",
      "exploration_percent",
      "exploitation_percent",
      "population_entropy",
      "diversity_dimension_mean",
      "diversity_dimension_min",
      "diversity_dimension_max",
      "progress_ratio",
      "fuzzy_input_diversity",
      "fuzzy_membership_degrees",
      "fuzzy_active_rules",
      "fuzzy_rule_firing_strengths",
      "fuzzy_output_normalized",
      "inertia_weight"
    ]
  },
  "metrics": {
    "run_status": {
      "version": 1,
      "name": "Estado de la réplica",
      "description": "Estado terminal o de ejecución y, cuando corresponda, información estructurada del error.",
      "scope": ["replica"],
      "source": "experiment.runner",
      "dtype": "string",
      "unit": "category",
      "direction": "diagnostic",
      "valid_range": "planned|running|completed|failed|cancelled",
      "sampling": "state_change",
      "aggregation": "counts_by_status",
      "missing_policy": "forbidden"
    },
    "replica_index": {
      "version": 1,
      "name": "Índice de réplica",
      "description": "Posición estable de una corrida independiente dentro de una configuración experimental.",
      "scope": ["replica"],
      "source": "experiment.plan",
      "dtype": "integer",
      "unit": "index",
      "direction": "identifier",
      "valid_range": ">= 0",
      "sampling": "once",
      "aggregation": "none",
      "missing_policy": "forbidden"
    },
    "random_seed": {
      "version": 1,
      "name": "Semilla de réplica",
      "description": "Semilla persistida de la réplica; su derivación se definirá en la implementación independiente de semillas.",
      "scope": ["replica"],
      "source": "experiment.seeding",
      "dtype": "integer",
      "unit": "seed",
      "direction": "identifier",
      "valid_range": "implementation_defined_non_negative_integer",
      "sampling": "once",
      "aggregation": "none",
      "missing_policy": "forbidden_in_v2"
    },
    "objective_best": {
      "version": 1,
      "name": "Mejor valor objetivo",
      "description": "Mejor valor de la función objetivo alcanzado hasta el punto de observación.",
      "scope": ["replica", "iteration"],
      "source": "solver",
      "dtype": "float",
      "unit": "problem_objective",
      "direction": "problem_defined",
      "valid_range": "finite",
      "sampling": "final_and_configurable_trace",
      "aggregation": "min|max|mean|median|std|quantiles as declared by problem direction",
      "missing_policy": "forbidden_on_completed_run"
    },
    "evaluations": {
      "version": 1,
      "name": "Evaluaciones de función objetivo",
      "description": "Número acumulado de evaluaciones consumidas, incluida la evaluación de la población inicial.",
      "scope": ["replica", "iteration"],
      "source": "solver.evaluation_counter",
      "dtype": "integer",
      "unit": "evaluations",
      "direction": "cost",
      "valid_range": ">= 0 and monotonic",
      "sampling": "final_and_configurable_trace",
      "aggregation": "final|max",
      "missing_policy": "forbidden"
    },
    "runtime_total_seconds": {
      "version": 1,
      "name": "Duración total",
      "description": "Tiempo de pared total de la réplica medido con un reloj monotónico.",
      "scope": ["replica"],
      "source": "experiment.runner",
      "dtype": "float",
      "unit": "seconds",
      "direction": "minimize_cost",
      "valid_range": ">= 0 and finite",
      "sampling": "once_at_end",
      "aggregation": "mean|median|std|quantiles",
      "missing_policy": "required_on_terminal_state_when_measurable"
    },
    "feasible": {
      "version": 1,
      "name": "Factibilidad",
      "description": "Indica si la mejor solución satisface todas las restricciones del problema.",
      "scope": ["replica", "iteration"],
      "source": "problem.constraints",
      "dtype": "boolean",
      "unit": "boolean",
      "direction": "true_preferred",
      "valid_range": "true|false",
      "sampling": "final_and_optional_trace",
      "aggregation": "feasibility_rate",
      "missing_policy": "not_applicable_for_unconstrained_problem"
    },
    "constraint_violation": {
      "version": 1,
      "name": "Violación de restricciones",
      "description": "Magnitud agregada de violación según el contrato de la familia de problemas.",
      "scope": ["replica", "iteration"],
      "source": "problem.constraints",
      "dtype": "float",
      "unit": "problem_defined",
      "direction": "minimize",
      "valid_range": ">= 0 and finite",
      "sampling": "final_and_optional_trace",
      "aggregation": "mean|median|max|feasible_rate",
      "missing_policy": "not_applicable_for_unconstrained_problem"
    },
    "iteration_index": {
      "version": 1,
      "name": "Índice de iteración",
      "description": "Índice del punto de control; cero representa la población inicial evaluada.",
      "scope": ["iteration"],
      "source": "solver",
      "dtype": "integer",
      "unit": "iteration",
      "direction": "index",
      "valid_range": ">= 0 and monotonic",
      "sampling": "each_recorded_checkpoint",
      "aggregation": "none",
      "missing_policy": "forbidden_for_trace"
    },
    "iteration_time_seconds": {
      "version": 1,
      "name": "Duración de iteración",
      "description": "Tiempo de pared del paso registrado; no incluye necesariamente toda la sobrecarga del runner.",
      "scope": ["iteration"],
      "source": "solver",
      "dtype": "float",
      "unit": "seconds",
      "direction": "minimize_cost",
      "valid_range": ">= 0 and finite",
      "sampling": "each_recorded_checkpoint",
      "aggregation": "sum|mean|median|quantiles",
      "missing_policy": "allowed_if_timing_disabled"
    },
    "objective_mean": {
      "version": 1,
      "name": "Media poblacional del objetivo",
      "description": "Media de los valores objetivo de la población en el punto observado.",
      "scope": ["iteration"],
      "source": "solver.population_fitness",
      "dtype": "float",
      "unit": "problem_objective",
      "direction": "diagnostic",
      "valid_range": "finite",
      "sampling": "configurable_trace",
      "aggregation": "mean_across_replicas_at_aligned_budget",
      "missing_policy": "allowed_if_not_selected"
    },
    "objective_std": {
      "version": 1,
      "name": "Desviación poblacional del objetivo",
      "description": "Desviación estándar de los valores objetivo de la población en el punto observado.",
      "scope": ["iteration"],
      "source": "solver.population_fitness",
      "dtype": "float",
      "unit": "problem_objective",
      "direction": "diagnostic",
      "valid_range": ">= 0 and finite",
      "sampling": "configurable_trace",
      "aggregation": "declared_summary_only",
      "missing_policy": "allowed_if_not_selected"
    },
    "diversity_hussain": {
      "version": 1,
      "name": "Diversidad global de Hussain",
      "description": "Diversidad global calculada por Diversity.Codes.hussainDiversity; la fórmula debe conservar versión explícita.",
      "scope": ["iteration"],
      "source": "Diversity.Codes.hussainDiversity",
      "dtype": "float",
      "unit": "search_space",
      "direction": "diagnostic",
      "valid_range": ">= 0 and finite",
      "sampling": "configurable_trace",
      "aggregation": "trajectory_or_aligned_summary",
      "missing_policy": "never_reconstruct_as_observed"
    },
    "exploration_percent": {
      "version": 1,
      "name": "Exploración",
      "description": "Porcentaje XPL derivado de la diversidad corriente respecto del máximo observado por la implementación vigente.",
      "scope": ["iteration"],
      "source": "Diversity.Codes.XPLXTP.porcentajesXLPXPT",
      "dtype": "float",
      "unit": "percent",
      "direction": "diagnostic",
      "valid_range": "[0, 100]",
      "sampling": "configurable_trace",
      "aggregation": "trajectory_or_aligned_summary",
      "missing_policy": "never_reconstruct_as_observed"
    },
    "exploitation_percent": {
      "version": 1,
      "name": "Explotación",
      "description": "Porcentaje XPT complementario producido por la implementación vigente.",
      "scope": ["iteration"],
      "source": "Diversity.Codes.XPLXTP.porcentajesXLPXPT",
      "dtype": "float",
      "unit": "percent",
      "direction": "diagnostic",
      "valid_range": "[0, 100]",
      "sampling": "configurable_trace",
      "aggregation": "trajectory_or_aligned_summary",
      "missing_policy": "never_reconstruct_as_observed"
    },
    "population_entropy": {
      "version": 1,
      "name": "Entropía poblacional media",
      "description": "Media por dimensión de entropías normalizadas de histogramas; bins efectivos limitados por sqrt(N).",
      "scope": ["iteration"],
      "source": "Diversity.Codes.populationEntropy.population_entropy",
      "dtype": "float",
      "unit": "normalized",
      "direction": "diagnostic",
      "valid_range": "[0, 1]",
      "sampling": "configurable_trace",
      "aggregation": "trajectory_or_aligned_summary",
      "missing_policy": "allowed_if_not_selected"
    },
    "diversity_dimension_mean": {
      "version": 1,
      "name": "Diversidad media por dimensión",
      "description": "Media de Div_j, donde Div_j es la desviación absoluta media respecto de la mediana de cada dimensión.",
      "scope": ["iteration"],
      "source": "Diversity.Codes.diversityDimention.diversity_per_dimension",
      "dtype": "float",
      "unit": "search_space",
      "direction": "diagnostic",
      "valid_range": ">= 0 and finite",
      "sampling": "configurable_trace",
      "aggregation": "trajectory_or_aligned_summary",
      "missing_policy": "allowed_if_not_selected"
    },
    "diversity_dimension_min": {
      "version": 1,
      "name": "Diversidad mínima por dimensión",
      "description": "Mínimo de Div_j en el punto observado.",
      "scope": ["iteration"],
      "source": "Diversity.Codes.diversityDimention.diversity_per_dimension",
      "dtype": "float",
      "unit": "search_space",
      "direction": "diagnostic",
      "valid_range": ">= 0 and finite",
      "sampling": "configurable_trace",
      "aggregation": "trajectory_or_aligned_summary",
      "missing_policy": "allowed_if_not_selected"
    },
    "diversity_dimension_max": {
      "version": 1,
      "name": "Diversidad máxima por dimensión",
      "description": "Máximo de Div_j en la iteración corriente; no debe reutilizarse el valor de la iteración cero.",
      "scope": ["iteration"],
      "source": "Diversity.Codes.diversityDimention.diversity_per_dimension",
      "dtype": "float",
      "unit": "search_space",
      "direction": "diagnostic",
      "valid_range": ">= 0 and finite",
      "sampling": "configurable_trace",
      "aggregation": "trajectory_or_aligned_summary",
      "missing_policy": "allowed_if_not_selected"
    },
    "progress_ratio": {
      "version": 1,
      "name": "Progreso normalizado",
      "description": "Entrada temporal del controlador calculada como progreso del presupuesto en [0,1].",
      "scope": ["iteration"],
      "source": "optimizer.fuzzy_controller_input",
      "dtype": "float",
      "unit": "normalized",
      "direction": "diagnostic",
      "valid_range": "[0, 1]",
      "sampling": "configurable_trace",
      "aggregation": "alignment_axis",
      "missing_policy": "not_applicable_without_fuzzy_controller"
    },
    "fuzzy_input_diversity": {
      "version": 1,
      "name": "Diversidad normalizada de entrada difusa",
      "description": "Valor exacto entregado como entrada de diversidad al controlador, antes de la fuzzificación.",
      "scope": ["iteration"],
      "source": "optimizer.fuzzy_controller_input",
      "dtype": "float",
      "unit": "normalized",
      "direction": "diagnostic",
      "valid_range": "[0, 1]",
      "sampling": "configurable_trace",
      "aggregation": "trajectory_or_aligned_summary",
      "missing_policy": "not_applicable_without_fuzzy_controller"
    },
    "fuzzy_membership_degrees": {
      "version": 1,
      "name": "Grados de pertenencia",
      "description": "Mapa estructurado de etiqueta lingüística a grado para cada variable de entrada.",
      "scope": ["iteration"],
      "source": "fuzzy_controller.fuzzification",
      "dtype": "json",
      "unit": "normalized",
      "direction": "diagnostic",
      "valid_range": "each degree in [0, 1]",
      "sampling": "configurable_trace",
      "aggregation": "activation_frequency_or_declared_summary",
      "missing_policy": "not_applicable_without_fuzzy_controller"
    },
    "fuzzy_active_rules": {
      "version": 1,
      "name": "Reglas difusas activas",
      "description": "Identificadores estables de las reglas con fuerza de activación positiva.",
      "scope": ["iteration"],
      "source": "fuzzy_controller.inference",
      "dtype": "json",
      "unit": "rule_ids",
      "direction": "diagnostic",
      "valid_range": "registered_rule_ids",
      "sampling": "configurable_trace",
      "aggregation": "activation_frequency",
      "missing_policy": "not_applicable_without_fuzzy_controller"
    },
    "fuzzy_rule_firing_strengths": {
      "version": 1,
      "name": "Fuerzas de activación",
      "description": "Mapa de identificador de regla a fuerza de activación en el paso observado.",
      "scope": ["iteration"],
      "source": "fuzzy_controller.inference",
      "dtype": "json",
      "unit": "normalized",
      "direction": "diagnostic",
      "valid_range": "each strength in [0, 1]",
      "sampling": "configurable_trace",
      "aggregation": "frequency|mean_strength",
      "missing_policy": "not_applicable_without_fuzzy_controller"
    },
    "fuzzy_output_normalized": {
      "version": 1,
      "name": "Salida difusa normalizada",
      "description": "Centroide normalizado antes de escalarlo al intervalo del parámetro controlado.",
      "scope": ["iteration"],
      "source": "fuzzy_controller.defuzzification",
      "dtype": "float",
      "unit": "normalized",
      "direction": "diagnostic",
      "valid_range": "[0, 1]",
      "sampling": "configurable_trace",
      "aggregation": "trajectory_or_aligned_summary",
      "missing_policy": "not_applicable_without_fuzzy_controller"
    },
    "inertia_weight": {
      "version": 1,
      "name": "Peso de inercia aplicado",
      "description": "Valor de w aplicado por PSO en el paso observado, sea lineal o controlado de forma difusa.",
      "scope": ["iteration"],
      "source": "optimizer.pso",
      "dtype": "float",
      "unit": "parameter",
      "direction": "diagnostic",
      "valid_range": "configured_bounds",
      "sampling": "configurable_trace",
      "aggregation": "trajectory_or_aligned_summary",
      "missing_policy": "not_applicable_for_optimizer"
    },
    "legacy_gap_percent": {
      "version": 1,
      "name": "GAP porcentual heredado",
      "description": "Fórmula histórica ((best-optimum)/best)*100. Se registra para trazabilidad y requiere decisión metodológica antes de adoptarse como métrica v2.",
      "scope": ["iteration", "replica"],
      "source": "Diversity.Codes.gap_rdp_calculation.compute_gap_rdp",
      "dtype": "float",
      "unit": "percent",
      "direction": "legacy_review_required",
      "valid_range": "implementation_defined; returns 0 when denominator is invalid",
      "sampling": "legacy",
      "aggregation": "do_not_use_as_v2_default",
      "missing_policy": "legacy"
    },
    "legacy_rdp_percent": {
      "version": 1,
      "name": "RDP porcentual heredado",
      "description": "Fórmula histórica ((best-optimum)/optimum)*100. Devuelve cero para óptimo cero; requiere decisión metodológica antes de adoptarse en v2.",
      "scope": ["iteration", "replica"],
      "source": "Diversity.Codes.gap_rdp_calculation.compute_gap_rdp",
      "dtype": "float",
      "unit": "percent",
      "direction": "legacy_review_required",
      "valid_range": "implementation_defined; zero optimum is ambiguous",
      "sampling": "legacy",
      "aggregation": "do_not_use_as_v2_default",
      "missing_policy": "legacy"
    }
  }
}
