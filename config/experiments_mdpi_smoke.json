        "SCP": {},
        "USCP": {},
        "KP": {}
    },

    "use_seed": true,
    "seed": 42,
    "parallel_workers": 6,
    "console_summary_only": true,

    "instancias": {
        "BEN": ["F1", "F5", "F9", "F12", "F21", "F23"],
