            {"w_set": "O1", "num_labels": 3, "input_set": "I1", "rule_set": "R1", "wMin": 0.1, "wMax": 0.9},
            {"w_set": "O1", "num_labels": 9, "input_set": "I1", "rule_set": "R1", "wMin": 0.1, "wMax": 0.9},
            {"w_set": "O1", "num_labels": 3, "input_set": "I1", "rule_set": "R8", "wMin": 0.1, "wMax": 0.9},
