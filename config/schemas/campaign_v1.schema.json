{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afcs.local/schemas/campaign_v1.schema.json",
  "title": "AFCS v2 campaign configuration",
  "description": "Declaración reproducible de una campaña experimental AFCS v2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign", "randomness", "problems", "treatments", "execution", "trace"],
  "properties": {
    "$schema": {"type": "string", "description": "Ruta al esquema para validación y ayuda del editor."},
    "_documentation": {"type": "object", "description": "Ayuda humana ignorada por el ejecutor; no altera el experimento."},
    "schema_version": {"const": 1, "description": "Versión del contrato de configuración."},
    "campaign": {"$ref": "#/$defs/campaign"},
    "randomness": {"$ref": "#/$defs/randomness"},
    "problems": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/cec2017Problems"}, {"$ref": "#/$defs/classicalProblems"}, {"$ref": "#/$defs/opfunuProblems"}]}},
    "treatments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/psoTreatment"}},
    "execution": {"$ref": "#/$defs/execution"},
    "trace": {"$ref": "#/$defs/trace"}
  },
  "$defs": {
    "campaign": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "replicas", "metrics"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "Identificador estable y único de la campaña."},
        "name": {"type": "string", "minLength": 1, "description": "Nombre legible de la campaña."},
        "replicas": {"type": "integer", "minimum": 1, "default": 31, "description": "Cantidad de corridas independientes por tratamiento."},
        "metrics": {"$ref": "#/$defs/metricSelection"},
        "notes": {"type": ["string", "null"], "description": "Notas metodológicas opcionales."}
      }
    },
    "metricSelection": {
      "description": "Perfil, 'all', lista explícita o selección con include/exclude. Las métricas obligatorias siempre se registran.",
      "oneOf": [
        {"type": "string", "enum": ["minimal", "convergence", "optimizer", "fuzzy", "timing", "all"]},
        {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        {"type": "object", "additionalProperties": false, "properties": {
          "profile": {"type": "string", "enum": ["minimal", "convergence", "optimizer", "fuzzy", "timing", "all"], "default": "minimal"},
          "include": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "exclude": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }}
      ]
    },
    "randomness": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "base_seed", "engine"],
      "properties": {
        "protocol": {"const": "paired_by_replica_v1", "description": "Comparte la semilla de cada índice de réplica entre todos los tratamientos."},
        "base_seed": {"type": "integer", "minimum": 0, "default": 42, "description": "Semilla de la réplica 0; las siguientes son base_seed + replica_index."},
        "engine": {"const": "numpy_seedsequence_pcg64_v1", "description": "Motor y estrategia versionados para crear subflujos reproducibles."}
      }
    },
    "cec2017Problems": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "functions", "dimensions"],
      "properties": {
        "family": {"const": "CEC2017"},
        "functions": {"type": "array", "minItems": 1, "uniqueItems": true, "description": "Funciones válidas: F1 y F3-F30; F2 está excluida por la definición oficial.", "items": {"type": "integer", "minimum": 1, "maximum": 30, "not": {"const": 2}}},
        "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "enum": [10, 30, 50, 100]}}
      }
    },
    "classicalProblems": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "functions", "dimensions"],
      "properties": {
        "family": {"const": "CLASSICAL"},
        "functions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 23}},
        "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "opfunuProblems": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "suite_year", "functions", "dimensions"],
      "properties": {
        "family": {"const": "OPFUNU_CEC"},
        "suite_year": {"type": "integer", "minimum": 2000, "maximum": 2099},
        "functions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "psoTreatment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "optimizer", "parameters", "parameter_policy"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "Identificador único de la configuración algorítmica."},
        "optimizer": {"const": "PSO"},
        "parameters": {"$ref": "#/$defs/psoParameters"},
        "parameter_policy": {"oneOf": [{"$ref": "#/$defs/fixedInertia"}, {"$ref": "#/$defs/legacyLdiw"}, {"$ref": "#/$defs/fuzzyInertiaMamdani"}]}
      }
    },
    "psoParameters": {
      "type": "object", "additionalProperties": false,
      "required": ["population_size", "max_iterations"],
      "properties": {
        "population_size": {"type": "integer", "minimum": 1},
        "max_iterations": {"type": "integer", "minimum": 1},
        "cognitive": {"type": "number", "default": 2.0, "description": "Coeficiente cognitivo c1."},
        "social": {"type": "number", "default": 2.0, "description": "Coeficiente social c2."},
        "velocity_factor": {"type": "number", "minimum": 0, "default": 0.1, "description": "Fracción del rango usada como velocidad máxima."}
      }
    },
    "fixedInertia": {
      "type": "object", "additionalProperties": false, "required": ["id", "parameters"],
      "properties": {"id": {"const": "fixed_inertia"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["value"], "properties": {"value": {"type": "number"}}}}
    },
    "legacyLdiw": {
      "type": "object", "additionalProperties": false, "required": ["id", "parameters"],
      "properties": {"id": {"const": "legacy_ldiw"}, "parameters": {"type": "object", "additionalProperties": false, "properties": {"maximum": {"type": "number", "default": 0.9}, "minimum": {"type": "number", "default": 0.1}}}}
    },
    "fuzzyInertiaMamdani": {
      "type": "object", "additionalProperties": false, "required": ["id", "parameters"],
      "properties": {
        "id": {"const": "fuzzy_inertia_mamdani"},
        "parameters": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum", "maximum", "granularity", "rule_base", "membership_family", "overlap", "zero_overlap_boundary_policy"],
          "properties": {
            "minimum": {"type": "number", "description": "Límite inferior efectivo de w."},
            "maximum": {"type": "number", "description": "Límite superior efectivo de w."},
            "granularity": {"type": "integer", "enum": [3, 5, 7, 9]},
            "rule_base": {"type": "string", "enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"]},
            "membership_family": {"type": "string", "enum": ["triangular_v1", "gaussian_v1"], "description": "El factorial principal aprobado utiliza triangular_v1; gaussian_v1 queda disponible para estudios posteriores."},
            "overlap": {"$ref": "#/$defs/fuzzyOverlap"},
            "zero_overlap_boundary_policy": {"const": "nearest_center_tie_upper"},
            "centroid_grid_points": {"type": "integer", "minimum": 101, "default": 501},
            "inference_evaluation_mode": {"type": "string", "enum": ["dense_v1", "sparse_v1"], "default": "dense_v1", "description": "La campaña principal usa dense_v1; sparse_v1 requiere equivalencia validada y se compara en microbenchmarks."}
          }
        }
      }
    },
    "fuzzyOverlap": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "value"],
          "properties": {
            "mode": {"const": "shared"},
            "value": {"type": "number", "minimum": 0, "maximum": 1, "description": "0, 0.5 y 1 son los niveles aprobados para el factorial principal."}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "diversity", "progress", "output"],
          "properties": {
            "mode": {"const": "independent"},
            "diversity": {"type": "number", "minimum": 0, "maximum": 1},
            "progress": {"type": "number", "minimum": 0, "maximum": 1},
            "output": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      ]
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "properties": {"parallel_workers": {"type": "integer", "minimum": 1, "default": 1, "description": "1 ejecuta secuencialmente; valores mayores distribuyen réplicas entre procesos aislados."}}
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "every_iterations", "include_initial", "include_final"],
      "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"include_final": {"const": true}}}}],
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "every_iterations": {"type": "integer", "minimum": 1, "default": 1, "description": "Registra cada k iteraciones; el punto final nunca se omite."},
        "include_initial": {"type": "boolean", "default": true, "description": "Registra la población inicial ya evaluada como checkpoint 0."},
        "include_final": {"type": "boolean", "default": true, "description": "Obligatorio cuando las trazas están activas."}
      }
    }
  }
}
